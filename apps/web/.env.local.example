# ===========================================================================
# Supabase
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 僅 server-side 使用，絕對不要加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================================================
# App
# ===========================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 時區與準時判斷容差（分鐘）
APP_TIMEZONE=Asia/Taipei
APP_ON_TIME_TOLERANCE_MIN=15

# ===========================================================================
# 開發模式：允許不帶 Bearer token 的請求 fallback 成指定 driver
# ★ 僅限 NODE_ENV != production 時生效，正式環境會自動忽略
# ★ 設了之後，RLS 不會以 auth.uid() 過濾，service_role 會繞過 RLS
#   只用於 demo / 本機快速測試，**絕對不要在 production 設成 true**
# ===========================================================================
# ALLOW_DEV_DRIVER=true
# DEV_DRIVER_EMAIL=driver1@example.com

# ===========================================================================
# TomTom（路徑時間矩陣）
# ===========================================================================
# 沒設就 fallback 用 haversine + 30 km/h 估算（demo 可接受，但時間會偏離真實）。
# Key 申請：https://developer.tomtom.com/  → My Credentials → Add API key
TOMTOM_API_KEY=

# ===========================================================================
# OR engine（Python Gurobi solver）
# ===========================================================================
# 預設會自動偵測 or-engine/.venv/Scripts/python.exe（Windows）。
# 只有用 conda / system Python / 其他位置才需要顯式指定。
# OR_ENGINE_PYTHON=D:/github/SIGmile/or-engine/.venv/Scripts/python.exe

# OR engine 程式碼位置；預設為 repo root 下的 or-engine/，一般不用設。
# OR_ENGINE_ROOT=D:/github/SIGmile/or-engine

# Solve timeout（秒）— 超過就 fallback 跑 mock。Default 120。
# OR_ENGINE_TIMEOUT_SEC=120

# ===========================================================================
# 預留：未來真實整合（目前全部走 mock，不需設定）
# ===========================================================================
# GOOGLE_MAPS_API_KEY=
# OR_ENGINE_ENDPOINT=
# AI_PROVIDER=mock        # mock | anthropic | openai
# ANTHROPIC_API_KEY=
